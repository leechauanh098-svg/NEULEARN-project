NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Optional. Required on a trusted Flask server for Supabase Auth user administration.
# Never expose this key in frontend code or share it with users who only need to view materials.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional when the Flask API is not at http://127.0.0.1:5000
# NEXT_PUBLIC_FLASK_API_URL=http://127.0.0.1:5000